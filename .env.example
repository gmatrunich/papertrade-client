# Generate with: uv run papertrade keygen --out .env  (mode 0600)
PAPERTRADE_WALLET_PRIVATE_KEY=0x...
# default: ~/.local/share/papertrade-client (shared by every process of this wallet)
# PAPERTRADE_DATA_DIR=
# false = every signed write is a dry run
PAPERTRADE_LIVE_TRADING=false
PAPERTRADE_MAX_MARGIN_USD=10
PAPERTRADE_MAX_LEVERAGE=50
PAPERTRADE_MAX_OPEN_POSITIONS=1
PAPERTRADE_MAX_TOTAL_MARGIN_USD=10
PAPERTRADE_DAILY_LOSS_LIMIT_USD=10
PAPERTRADE_SESSION_RENEW_BEFORE_H=72
# papertrade watchdog: alerts go to stdout unless both are set
# PAPERTRADE_TELEGRAM_BOT_TOKEN=
# PAPERTRADE_TELEGRAM_CHAT_ID=
