[Unit]
Description=Papertrade protocol drift monitor (engages the kill switch on breaking drift)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO@
Environment=PAPERTRADE_DATA_DIR=%h/.local/share/papertrade-client
EnvironmentFile=%h/.config/papertrade/env
ExecStart=@REPO@/.venv/bin/papertrade drift --kill-on-breaking --json ${PAPERTRADE_DATA_DIR}/drift.json
# 1 = warn, 2 = breaking: reported through drift.json and the watchdog, not a unit failure.
SuccessExitStatus=1 2
TimeoutStartSec=15min
