[Unit]
Description=Papertrade execution probe about once an hour (not enabled by install.sh)

[Timer]
# One run in each hour at a random minute (0-50 min after :00), so runs stay at least 10 min apart:
# more than the 5-minute hold plus the close, and MAX_OPEN_POSITIONS=1 refuses any overlap anyway.
OnCalendar=hourly
RandomizedDelaySec=50min

[Install]
WantedBy=timers.target
